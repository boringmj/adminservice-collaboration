# .env
#
# 注释请用 "#" 号;配置格式为 "KEY=VALUE"
#
# 键名**大小写敏感**, 点号是普通字符(没有层级语义)
# 值只做 true/false/null 的类型转换, **数字保持字符串** —— 要数字请在 config/*.php 里显式转换
# 值里含 `=` / 空格 / `#` 时用引号包起来: DB_PASSWORD="a=b # c"
#
# 这里的键分两类:
#   · 小写点分路径(如 database.connections.default.host) → **覆盖**同名配置项;
#     路径必须写全(只覆盖已存在的路径, 绝不新建节点), 写错会被静默忽略 ——
#     部署前用 `php tools/config_lint.php` 查
#   · 全大写蛇形(下面这些) → 一个**值来源**, 由 config/*.php 里的 env('KEY', 默认值) 读取;
#     缺失就用配置里写的默认值(框架不替使用者判断"该不该有这个键")
#
# 映射关系(哪个键喂给哪个配置项)随时可生成: php tools/config_lint.php --map

# 调试模式(生产请保持 false)
APP_DEBUG=false                            # → app.debug

# 数据库连接
DB_TYPE=mysql                              # → database.connections.default.type
DB_HOST=localhost                          # → database.connections.default.host
DB_PORT=3306                               # → database.connections.default.port(配置里 (int) 转换)
DB_NAME=                                   # → database.connections.default.dbname
DB_USER=                                   # → database.connections.default.user
DB_PASSWORD=                               # → database.connections.default.password
DB_CHARSET=utf8mb4                         # → database.connections.default.charset
DB_PREFIX=                                 # → database.connections.default.prefix

# 想临时覆盖上面之外的任何配置项, 直接照配置里的全路径写即可, 例如:
# log.path=/var/log/adminservice
# database.connections.default.port=13306
