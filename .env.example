# .env
#
# 注释请用 "#" 号;配置格式为 "KEY=VALUE"
#
# 键名**大小写敏感**, 点号是普通字符(没有层级语义)
# 值只做 true/false/null 的类型转换, **数字保持字符串** —— 要数字请在 config/*.php 里显式转换
# 值里含 `=` / 空格 / `#` 时用引号包起来: DB_PASSWORD="a=b # c"
#
# 这些键由 config/*.php 里的 env('KEY', 默认值) 显式读取;不传默认值的键是"必需键", 缺失会直接报错
# 对照检查可跑: php tools/config_lint.php

# 调试模式(生产请保持 false)
APP_DEBUG=false

# 数据库连接(见 config/database.php 的 connections.default)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PREFIX=
